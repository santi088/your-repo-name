<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Warm paper and bronze, kept deliberately desaturated so the reading
         surface stays the brightest thing on screen. -->
    <Color x:Key="Primary">#7A6244</Color>
    <Color x:Key="PrimaryDark">#574430</Color>
    <Color x:Key="PrimaryLight">#A78F66</Color>
    <Color x:Key="Secondary">#F3EDE1</Color>
    <Color x:Key="SecondaryAlt">#E9E1D2</Color>
    <Color x:Key="Surface">#FDFBF7</Color>
    <Color x:Key="SurfaceAlt">#EAE4D7</Color>
    <Color x:Key="Paper">#F5F1E8</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="Ink">#241F19</Color>
    <Color x:Key="InkSoft">#4F4740</Color>
    <Color x:Key="Muted">#857C6D</Color>
    <Color x:Key="Divider">#E3DBCC</Color>
    <Color x:Key="Spine">#8A7351</Color>
    <Color x:Key="Accent">#A98654</Color>
    <Color x:Key="Success">#6C8A6E</Color>
    <Color x:Key="Danger">#A2544A</Color>
    <Color x:Key="StatusTbr">#7C93A3</Color>
    <Color x:Key="StatusReading">#A98654</Color>
    <Color x:Key="StatusCompleted">#6C8A6E</Color>
    <Color x:Key="StatusDropped">#A5766A</Color>
    <Color x:Key="Highlight">#E9D7A4</Color>
    <Color x:Key="HighlightSoft">#F2E7C9</Color>
    <Color x:Key="WarmAccent">#C79A5B</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1B1815</Color>
    <Color x:Key="Gray100">#F2EEE5</Color>
    <Color x:Key="Gray200">#E3DBCC</Color>
    <Color x:Key="Gray300">#CFC5B2</Color>
    <Color x:Key="Gray400">#B0A692</Color>
    <Color x:Key="Gray500">#857C6D</Color>
    <Color x:Key="Gray600">#5A5248</Color>
    <Color x:Key="Gray900">#241F19</Color>
    <Color x:Key="Gray950">#17140F</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource Highlight}"/>
    <SolidColorBrush x:Key="HighlightSoftBrush" Color="{StaticResource HighlightSoft}"/>
    <SolidColorBrush x:Key="WarmAccentBrush" Color="{StaticResource WarmAccent}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="StatusTbrBrush" Color="{StaticResource StatusTbr}"/>
    <SolidColorBrush x:Key="StatusReadingBrush" Color="{StaticResource StatusReading}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource StatusCompleted}"/>
    <SolidColorBrush x:Key="StatusDroppedBrush" Color="{StaticResource StatusDropped}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
</ResourceDictionary>
