<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Primary">#8B6F47</Color>
    <Color x:Key="PrimaryDark">#6B5535</Color>
    <Color x:Key="PrimaryLight">#C4A265</Color>
    <Color x:Key="Secondary">#FFF8ED</Color>
    <Color x:Key="SecondaryAlt">#FFF3E0</Color>
    <Color x:Key="Surface">#FFFBF5</Color>
    <Color x:Key="SurfaceAlt">#FFF5E6</Color>
    <Color x:Key="Paper">#FFF9F0</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="Ink">#2D2418</Color>
    <Color x:Key="InkSoft">#4A3F2F</Color>
    <Color x:Key="Muted">#8C7E6A</Color>
    <Color x:Key="Divider">#EDE4D3</Color>
    <Color x:Key="Spine">#A68B5B</Color>
    <Color x:Key="Accent">#D4A853</Color>
    <Color x:Key="Danger">#C47055</Color>
    <Color x:Key="StatusTbr">#7BAFD4</Color>
    <Color x:Key="StatusReading">#D4A853</Color>
    <Color x:Key="StatusCompleted">#6BAF7A</Color>
    <Color x:Key="StatusDropped">#D48B7A</Color>
    <Color x:Key="Highlight">#FFE082</Color>
    <Color x:Key="HighlightSoft">#FFF3C4</Color>
    <Color x:Key="WarmAccent">#FFB74D</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="Gray100">#F5F0E5</Color>
    <Color x:Key="Gray200">#EDE4D3</Color>
    <Color x:Key="Gray300">#D4C9B5</Color>
    <Color x:Key="Gray400">#B5A892</Color>
    <Color x:Key="Gray500">#8C7E6A</Color>
    <Color x:Key="Gray600">#5C5244</Color>
    <Color x:Key="Gray900">#2D2418</Color>
    <Color x:Key="Gray950">#18150f</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource Highlight}"/>
    <SolidColorBrush x:Key="HighlightSoftBrush" Color="{StaticResource HighlightSoft}"/>
    <SolidColorBrush x:Key="WarmAccentBrush" Color="{StaticResource WarmAccent}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="StatusTbrBrush" Color="{StaticResource StatusTbr}"/>
    <SolidColorBrush x:Key="StatusReadingBrush" Color="{StaticResource StatusReading}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource StatusCompleted}"/>
    <SolidColorBrush x:Key="StatusDroppedBrush" Color="{StaticResource StatusDropped}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
</ResourceDictionary>
