<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Warm paper and bronze, kept deliberately desaturated so the reading
         surface stays the calmest thing on screen.

         Paper is the app background, Ink is the reading text; every other tone is
         one quiet step between the two (Surface/SurfaceAlt for raised and inset
         fills, Card for book cards, Divider for hairlines, Muted for metadata). -->
    <Color x:Key="Primary">#7A6244</Color>
    <Color x:Key="PrimaryDark">#5C4A34</Color>
    <Color x:Key="PrimaryLight">#A78F66</Color>
    <Color x:Key="Secondary">#F4EDE0</Color>
    <Color x:Key="SecondaryAlt">#EBE1D1</Color>
    <Color x:Key="Surface">#FFFCF6</Color>
    <Color x:Key="SurfaceAlt">#F3ECE0</Color>
    <Color x:Key="Paper">#FBF6EA</Color>
    <Color x:Key="Card">#FFFDF9</Color>
    <Color x:Key="PageBackdrop">#E9DFCE</Color>
    <Color x:Key="Ink">#402A18</Color>
    <Color x:Key="InkSoft">#5F4732</Color>
    <Color x:Key="Muted">#7A6A56</Color>
    <Color x:Key="Divider">#E8DDCB</Color>
    <Color x:Key="Shadow">#402A18</Color>
    <Color x:Key="Spine">#8A7351</Color>
    <Color x:Key="Accent">#A98654</Color>
    <Color x:Key="Success">#6C8A6E</Color>
    <Color x:Key="Danger">#A2544A</Color>
    <Color x:Key="StatusTbr">#7C93A3</Color>
    <Color x:Key="StatusReading">#A98654</Color>
    <Color x:Key="StatusCompleted">#6C8A6E</Color>
    <Color x:Key="StatusDropped">#A5766A</Color>
    <Color x:Key="Highlight">#E9D7A4</Color>
    <Color x:Key="HighlightSoft">#F2E7C9</Color>
    <Color x:Key="WarmAccent">#C79A5B</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1B1815</Color>
    <!-- Neutral ramp, warmed so it never fights the paper background. -->
    <Color x:Key="Gray100">#F3EEE4</Color>
    <Color x:Key="Gray200">#E8DDCB</Color>
    <Color x:Key="Gray300">#D6C9B3</Color>
    <Color x:Key="Gray400">#A2917A</Color>
    <Color x:Key="Gray500">#7A6A56</Color>
    <Color x:Key="Gray600">#5F4732</Color>
    <Color x:Key="Gray900">#402A18</Color>
    <Color x:Key="Gray950">#2A1C10</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}"/>
    <SolidColorBrush x:Key="PageBackdropBrush" Color="{StaticResource PageBackdrop}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoft}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource Shadow}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource Highlight}"/>
    <SolidColorBrush x:Key="HighlightSoftBrush" Color="{StaticResource HighlightSoft}"/>
    <SolidColorBrush x:Key="WarmAccentBrush" Color="{StaticResource WarmAccent}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="StatusTbrBrush" Color="{StaticResource StatusTbr}"/>
    <SolidColorBrush x:Key="StatusReadingBrush" Color="{StaticResource StatusReading}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource StatusCompleted}"/>
    <SolidColorBrush x:Key="StatusDroppedBrush" Color="{StaticResource StatusDropped}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
</ResourceDictionary>
