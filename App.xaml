<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PAGELY.Converters"
             xmlns:local="clr-namespace:PAGELY"
             x:Class="PAGELY.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:HasValueConverter x:Key="HasValue" />
            <converters:InverseHasValueConverter x:Key="InverseHasValue" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:StatusColorConverter x:Key="StatusColor" />
            <converters:PercentToProgressConverter x:Key="PercentToProgress" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
