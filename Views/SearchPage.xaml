<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Search"
    x:DataType="vm:SearchViewModel"
    Title="Search"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Label
            Margin="20,18,20,10"
            Style="{StaticResource PageTitle}"
            Text="Search" />

        <VerticalStackLayout Grid.Row="1" Padding="20,0" Spacing="10">
            <Border Padding="4,0" Style="{StaticResource CardBorder}">
                <SearchBar
                    CancelButtonColor="{StaticResource Primary}"
                    FontFamily="OpenSansRegular"
                    HeightRequest="44"
                    Placeholder="Title, author, genre, or status"
                    PlaceholderColor="{StaticResource Muted}"
                    Text="{Binding Query}"
                    TextColor="{StaticResource Ink}" />
            </Border>

            <Button
                Clicked="OnFilterToggleClicked"
                FontSize="13"
                HorizontalOptions="Start"
                Style="{StaticResource ButtonSecondary}"
                Text="Filters" />

            <Border
                IsVisible="{Binding IsFilterVisible}"
                Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Picker
                            FontFamily="OpenSansRegular"
                            HeightRequest="46"
                            ItemsSource="{Binding StatusFilters}"
                            SelectedItem="{Binding SelectedStatus}"
                            Title="Status"
                            TitleColor="{StaticResource Muted}"
                            TextColor="{StaticResource Ink}" />
                        <Picker
                            Grid.Column="1"
                            FontFamily="OpenSansRegular"
                            HeightRequest="46"
                            ItemsSource="{Binding Genres}"
                            SelectedItem="{Binding SelectedGenre}"
                            Title="Genre"
                            TitleColor="{StaticResource Muted}"
                            TextColor="{StaticResource Ink}" />
                    </Grid>
                    <Picker
                        FontFamily="OpenSansRegular"
                        HeightRequest="46"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSort}"
                        Title="Sort by"
                        TitleColor="{StaticResource Muted}"
                        TextColor="{StaticResource Ink}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
            ItemsSource="{Binding Books}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Grid Padding="20,0">
                        <Border Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenCommand, Source={x:Reference Search}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Title}"
                                    TextColor="{StaticResource Ink}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Author}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Border Style="{StaticResource ChipBorder}">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11"
                                            Text="{Binding StatusLabel}"
                                            TextColor="{Binding StatusLabel, Converter={StaticResource StatusColor}}" />
                                    </Border>
                                    <Label
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Genre}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout
            Grid.Row="2"
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="40,0"
            Spacing="10">
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Text="No books found"
                TextColor="{StaticResource Ink}" />
            <Label
                FontSize="14"
                HorizontalTextAlignment="Center"
                MaximumWidthRequest="280"
                Text="No books match your search. Try a different title, author, or genre."
                TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
