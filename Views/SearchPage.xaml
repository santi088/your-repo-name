<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Search"
    x:DataType="vm:SearchViewModel"
    Title="Search"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*">

        <VerticalStackLayout Padding="20,16,20,12" Spacing="2">
            <Label Style="{StaticResource PageTitle}" Text="Search" />
            <Label
                Style="{StaticResource PageSubtitle}"
                Text="Find a title, author, genre or status" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="20,0,20,12" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Style="{StaticResource FieldBorder}">
                    <SearchBar
                        CancelButtonColor="{StaticResource Primary}"
                        FontFamily="OpenSansRegular"
                        HeightRequest="46"
                        Placeholder="Title, author, genre, or status"
                        PlaceholderColor="{StaticResource Muted}"
                        Text="{Binding Query}"
                        TextColor="{StaticResource Ink}" />
                </Border>
                <Button
                    Grid.Column="1"
                    Clicked="OnFilterToggleClicked"
                    FontSize="14"
                    HeightRequest="46"
                    Padding="16,0"
                    Style="{StaticResource ButtonSecondary}"
                    Text="Filters" />
            </Grid>

            <Border
                IsVisible="{Binding IsFilterVisible}"
                Padding="14"
                Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Margin="2,0,0,0" Style="{StaticResource SectionCaption}" Text="FILTER AND SORT" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker
                                FontFamily="OpenSansRegular"
                                HeightRequest="46"
                                ItemsSource="{Binding StatusFilters}"
                                SelectedItem="{Binding SelectedStatus}"
                                TextColor="{StaticResource Ink}"
                                Title="Status"
                                TitleColor="{StaticResource Muted}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Picker
                                FontFamily="OpenSansRegular"
                                HeightRequest="46"
                                ItemsSource="{Binding Genres}"
                                SelectedItem="{Binding SelectedGenre}"
                                TextColor="{StaticResource Ink}"
                                Title="Genre"
                                TitleColor="{StaticResource Muted}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker
                            FontFamily="OpenSansRegular"
                            HeightRequest="46"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSort}"
                            TextColor="{StaticResource Ink}"
                            Title="Sort by"
                            TitleColor="{StaticResource Muted}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
            ItemsSource="{Binding Books}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Grid Padding="20,0">
                        <Border Padding="12" Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenCommand, Source={x:Reference Search}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                                <Border
                                    BackgroundColor="{StaticResource Spine}"
                                    HeightRequest="76"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    VerticalOptions="Start"
                                    WidthRequest="52">
                                    <Grid>
                                        <Image
                                            Aspect="AspectFill"
                                            IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                            Source="{Binding CoverPath}" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                            Text="{Binding Initial}"
                                            TextColor="{StaticResource Surface}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label
                                        FontSize="15"
                                        MaxLines="2"
                                        Style="{StaticResource CardTitle}"
                                        Text="{Binding Title}" />
                                    <Label Style="{StaticResource CardMeta}" Text="{Binding Author}" />
                                    <HorizontalStackLayout Margin="0,2,0,0" Spacing="8">
                                        <Border Style="{StaticResource ChipBorder}">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="11"
                                                Text="{Binding StatusLabel}"
                                                TextColor="{Binding StatusLabel, Converter={StaticResource StatusColor}}" />
                                        </Border>
                                        <Label
                                            Style="{StaticResource CardMeta}"
                                            Text="{Binding Genre}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Border
                                        HeightRequest="5"
                                        Margin="0,4,0,0"
                                        Style="{StaticResource ProgressPill}">
                                        <ProgressBar
                                            BackgroundColor="Transparent"
                                            HeightRequest="5"
                                            Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                            ProgressColor="{StaticResource Primary}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout
            Grid.Row="2"
            HorizontalOptions="Center"
            IsVisible="{Binding IsEmpty}"
            Padding="40,0"
            Spacing="10"
            VerticalOptions="Center">
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="19"
                HorizontalTextAlignment="Center"
                Text="No books found"
                TextColor="{StaticResource Ink}" />
            <Label
                HorizontalTextAlignment="Center"
                MaximumWidthRequest="290"
                Style="{StaticResource PageSubtitle}"
                Text="Nothing matches this search yet. Try another title, author, genre or status." />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
