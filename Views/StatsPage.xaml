<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:StatsViewModel"
    Title="Statistics"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="20,16,20,12" Spacing="2">
            <Label Style="{StaticResource PageTitle}" Text="Statistics" />
            <Label Style="{StaticResource PageSubtitle}" Text="Your reading journey at a glance" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,40" Spacing="12">

                <VerticalStackLayout IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}" Spacing="12">

                    <Border Padding="16" Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Style="{StaticResource SectionCaption}" Text="CURRENT STREAK" />
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="34"
                                        Text="{Binding Stats.CurrentStreak}"
                                        TextColor="{StaticResource Ink}" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource PageSubtitle}"
                                        Text="days"
                                        VerticalOptions="End" />
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="8">
                                <Label HorizontalOptions="End" Style="{StaticResource SectionCaption}" Text="BEST STREAK" />
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="22"
                                        Text="{Binding Stats.LongestStreak}"
                                        TextColor="{StaticResource Primary}" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="0,0,0,3"
                                        Style="{StaticResource Caption}"
                                        Text="days"
                                        VerticalOptions="End" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Padding="14" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionCaption}" Text="BOOKS" />
                            <Grid
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="10">
                                <Border
                                    Padding="10,12"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource StatValue}" Text="{Binding Stats.TotalBooks}" TextColor="{StaticResource Primary}" />
                                        <Label FontSize="11" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="Total" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="10,12"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource StatValue}" Text="{Binding Stats.CurrentlyReading}" TextColor="{StaticResource Accent}" />
                                        <Label FontSize="11" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="Reading" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Padding="10,12"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource StatValue}" Text="{Binding Stats.Completed}" TextColor="{StaticResource Success}" />
                                        <Label FontSize="11" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="Finished" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Padding="10,12"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource StatValue}" Text="{Binding Stats.ToBeRead}" TextColor="{StaticResource InkSoft}" />
                                        <Label FontSize="11" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="To read" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="10,12"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource StatValue}" Text="{Binding Stats.Dropped}" TextColor="{StaticResource Danger}" />
                                        <Label FontSize="11" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="Dropped" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Padding="10,12"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource StatValue}" Text="{Binding Stats.BooksReadThisMonth}" TextColor="{StaticResource InkSoft}" />
                                        <Label FontSize="11" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="This month" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Style="{StaticResource SectionCaption}" Text="READING PROGRESS" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16"
                                    Text="{Binding Stats.AverageProgress, StringFormat='{0:F0}%'}"
                                    TextColor="{StaticResource InkSoft}" />
                            </Grid>
                            <Border HeightRequest="8" Style="{StaticResource ProgressPill}">
                                <ProgressBar
                                    BackgroundColor="Transparent"
                                    HeightRequest="8"
                                    Progress="{Binding Stats.AverageProgress, Converter={StaticResource PercentToProgress}}"
                                    ProgressColor="{StaticResource Primary}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Real per-book progress: what is open right now, most recent first. -->
                    <Border Padding="16" IsVisible="{Binding Stats.HasInProgress}" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionCaption}" Text="CURRENTLY READING" />
                            <VerticalStackLayout Spacing="12">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="Stats.InProgress" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:BookProgressEntry">
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="14"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1"
                                                    Text="{Binding Title}"
                                                    TextColor="{StaticResource Ink}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding ProgressPercent, StringFormat='{0:F0}%'}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                            <Border HeightRequest="5" Style="{StaticResource ProgressPill}">
                                                <ProgressBar
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="5"
                                                    Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                                    ProgressColor="{StaticResource Primary}" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16" IsVisible="{Binding Stats.HasRecentlyFinished}" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionCaption}" Text="RECENTLY FINISHED" />
                            <VerticalStackLayout Spacing="10">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="Stats.RecentlyFinished" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FinishedBook">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding Title}"
                                                TextColor="{StaticResource Ink}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding FinishedAt, StringFormat='{0:MMM d}'}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16" IsVisible="{Binding Stats.HasActivity}" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Style="{StaticResource SectionCaption}" Text="READING ACTIVITY" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Caption}"
                                    Text="Last 30 days"
                                    VerticalOptions="Center" />
                            </Grid>
                            <FlexLayout JustifyContent="Start" Wrap="Wrap">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="Stats.ActivityDays" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActivityDay">
                                        <Grid HeightRequest="12" Margin="0,0,6,6" WidthRequest="12">
                                            <Border
                                                BackgroundColor="{StaticResource Divider}"
                                                HeightRequest="12"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                WidthRequest="12" />
                                            <Border
                                                BackgroundColor="{StaticResource Primary}"
                                                HeightRequest="12"
                                                IsVisible="{Binding IsActive}"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                WidthRequest="12" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsEmpty}"
                    Padding="20,32"
                    Spacing="12">
                    <Border
                        BackgroundColor="{StaticResource SurfaceAlt}"
                        HeightRequest="64"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        WidthRequest="64">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="26"
                            HorizontalOptions="Center"
                            Text="P"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="19"
                        HorizontalTextAlignment="Center"
                        Margin="0,2,0,0"
                        Text="No reading data yet"
                        TextColor="{StaticResource Ink}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="290"
                        Style="{StaticResource PageSubtitle}"
                        Text="Import some books and start reading to see your statistics here." />
                </VerticalStackLayout>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
