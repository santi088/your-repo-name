<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:StatsViewModel"
    Title="Statistics"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="20,18,20,10" Spacing="2">
            <Label Style="{StaticResource PageTitle}" Text="Statistics" />
            <Label Style="{StaticResource Caption}" Text="Your reading journey at a glance" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,40" Spacing="12">

                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Style="{StaticResource SectionCaption}" Text="CURRENT STREAK" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="36"
                                Text="{Binding Stats.CurrentStreak, StringFormat='{0} days'}"
                                TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="6">
                            <Label HorizontalOptions="End" Style="{StaticResource SectionCaption}" Text="BEST STREAK" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="24"
                                HorizontalOptions="End"
                                Text="{Binding Stats.LongestStreak, StringFormat='{0} days'}"
                                TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Style="{StaticResource SectionCaption}" Text="BOOKS" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="28" HorizontalOptions="Center" Text="{Binding Stats.TotalBooks}" TextColor="{StaticResource Primary}" />
                                <Label HorizontalOptions="Center" Style="{StaticResource Caption}" Text="Total" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="28" HorizontalOptions="Center" Text="{Binding Stats.CurrentlyReading}" TextColor="{StaticResource Accent}" />
                                <Label HorizontalOptions="Center" Style="{StaticResource Caption}" Text="Reading" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="28" HorizontalOptions="Center" Text="{Binding Stats.Completed}" TextColor="{StaticResource Success}" />
                                <Label HorizontalOptions="Center" Style="{StaticResource Caption}" Text="Done" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="28" HorizontalOptions="Center" Text="{Binding Stats.ToBeRead}" TextColor="{StaticResource StatusTbr}" />
                                <Label HorizontalOptions="Center" Style="{StaticResource Caption}" Text="To Read" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="28" HorizontalOptions="Center" Text="{Binding Stats.Dropped}" TextColor="{StaticResource Danger}" />
                                <Label HorizontalOptions="Center" Style="{StaticResource Caption}" Text="Dropped" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="28" HorizontalOptions="Center" Text="{Binding Stats.BooksReadThisMonth}" TextColor="{StaticResource InkSoft}" />
                                <Label HorizontalOptions="Center" Style="{StaticResource Caption}" Text="This Month" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource SectionCaption}" Text="READING PROGRESS" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <ProgressBar
                                BackgroundColor="{StaticResource SurfaceAlt}"
                                HeightRequest="8"
                                Progress="{Binding Stats.AverageProgress, Converter={StaticResource PercentToProgress}}"
                                ProgressColor="{StaticResource Accent}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Text="{Binding Stats.AverageProgress, StringFormat='{0:F0}%'}"
                                TextColor="{StaticResource InkSoft}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Style="{StaticResource SectionCaption}" Text="READING TIME" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="24"
                                Text="{Binding Stats.TotalReadingTime}"
                                TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Style="{StaticResource SectionCaption}" Text="READING SPEED" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="24"
                                Text="{Binding Stats.AverageReadingSpeed}"
                                TextColor="{StaticResource Accent}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource SectionCaption}" Text="TOP GENRES" />
                        <FlexLayout JustifyContent="Start" Wrap="Wrap">
                            <BindableLayout.ItemsSource>
                                <Binding Path="Stats.TopGenres" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Margin="0,0,8,8" Style="{StaticResource ChipBorder}">
                                        <Label FontSize="13" Text="{Binding .}" TextColor="{StaticResource Spine}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsEmpty}"
                    Padding="40,24"
                    Spacing="8">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="No reading data yet"
                        TextColor="{StaticResource Ink}" />
                    <Label
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="300"
                        Text="Import some books and start reading to see your statistics here."
                        TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
