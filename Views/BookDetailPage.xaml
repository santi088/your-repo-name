<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.BookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:BookDetailViewModel"
    Title="Book"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">
        <Grid
            BackgroundColor="{StaticResource Surface}"
            ColumnDefinitions="Auto,*"
            Padding="12,12,16,12">
            <Button
                BackgroundColor="{StaticResource SurfaceAlt}"
                Clicked="OnBackClicked"
                CornerRadius="22"
                FontSize="20"
                HeightRequest="44"
                MinimumHeightRequest="44"
                Padding="0"
                Text="←"
                TextColor="{StaticResource Ink}"
                VerticalOptions="Center"
                WidthRequest="44" />
            <Label
                Grid.Column="1"
                FontFamily="OpenSansSemibold"
                FontSize="17"
                Padding="12,0"
                Text="Book Details"
                TextColor="{StaticResource Ink}"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,40" Spacing="14">
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                        <Border
                            BackgroundColor="{StaticResource Spine}"
                            HeightRequest="100"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            WidthRequest="72">
                            <Grid>
                                <Image
                                    Aspect="AspectFill"
                                    IsVisible="{Binding Book.CoverPath, Converter={StaticResource HasValue}}"
                                    Source="{Binding Book.CoverPath}" />
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="26"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding Book.CoverPath, Converter={StaticResource InverseHasValue}}"
                                    Text="{Binding Book.Initial}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="18"
                                Text="{Binding Title}"
                                TextColor="{StaticResource Ink}" />
                            <Label
                                FontFamily="OpenSansRegular"
                                FontSize="13"
                                Text="{Binding Author}"
                                TextColor="{StaticResource Muted}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Book.LastReadLabel}" />
                            <Border
                                HorizontalOptions="Start"
                                Margin="0,4,0,0"
                                Style="{StaticResource ChipBorder}">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11"
                                    Text="{Binding SelectedStatus}"
                                    TextColor="{Binding SelectedStatus, Converter={StaticResource StatusColor}}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <ProgressBar
                        BackgroundColor="{StaticResource SurfaceAlt}"
                        HeightRequest="4"
                        Progress="{Binding Book.ProgressPercent, Converter={StaticResource PercentToProgress}}"
                        ProgressColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        Text="{Binding Book.ProgressLabel}"
                        TextColor="{StaticResource InkSoft}"
                        VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource SectionCaption}" Text="READING STATUS" />
                    <Picker
                        FontFamily="OpenSansRegular"
                        HeightRequest="48"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding SelectedStatus}"
                        TextColor="{StaticResource Ink}"
                        TitleColor="{StaticResource Muted}" />
                </VerticalStackLayout>

                <VerticalStackLayout Margin="0,8,0,0" Spacing="10">
                    <Button Command="{Binding ReadCommand}" Style="{StaticResource ButtonPrimary}" Text="Read" />
                    <Button
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource ButtonSecondary}"
                        Text="Remove from library"
                        TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
