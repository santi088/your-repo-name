<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.BookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:BookDetailViewModel"
    Title="Book"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <Border
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Divider}"
            StrokeShape="RoundRectangle 0,0,20,20"
            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Padding="12,10,16,12">
                <Button
                    Clicked="OnBackClicked"
                    Style="{StaticResource ButtonIcon}"
                    Text="←" />
                <Label
                    Grid.Column="1"
                    FontFamily="OpenSansSemibold"
                    FontSize="17"
                    Padding="10,0,0,0"
                    Text="Book Details"
                    TextColor="{StaticResource Ink}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,40" Spacing="14">

                <Border Padding="14" Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="84,*" ColumnSpacing="14">
                        <Border
                            BackgroundColor="{StaticResource Spine}"
                            HeightRequest="118"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            WidthRequest="84">
                            <Grid>
                                <Image
                                    Aspect="AspectFill"
                                    IsVisible="{Binding Book.CoverPath, Converter={StaticResource HasValue}}"
                                    Source="{Binding Book.CoverPath}" />
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="28"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding Book.CoverPath, Converter={StaticResource InverseHasValue}}"
                                    Text="{Binding Book.Initial}"
                                    TextColor="{StaticResource Surface}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label
                                FontSize="18"
                                MaxLines="3"
                                Style="{StaticResource CardTitle}"
                                Text="{Binding Title}" />
                            <Label
                                FontSize="13"
                                Style="{StaticResource CardMeta}"
                                Text="{Binding Author}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Book.LastReadLabel}" />
                            <Border
                                HorizontalOptions="Start"
                                Margin="0,4,0,0"
                                Style="{StaticResource ChipBorder}">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11"
                                    Text="{Binding SelectedStatus}"
                                    TextColor="{Binding SelectedStatus, Converter={StaticResource StatusColor}}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Style="{StaticResource SectionCaption}"
                                Text="READING PROGRESS"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontFamily="OpenSansSemibold"
                                FontSize="22"
                                Text="{Binding Book.ProgressLabel}"
                                TextColor="{StaticResource Ink}" />
                        </Grid>
                        <Border HeightRequest="8" Style="{StaticResource ProgressPill}">
                            <ProgressBar
                                BackgroundColor="Transparent"
                                HeightRequest="8"
                                Progress="{Binding Book.ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                ProgressColor="{StaticResource Primary}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Margin="2,0,0,0" Style="{StaticResource SectionCaption}" Text="READING STATUS" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker
                            FontFamily="OpenSansRegular"
                            HeightRequest="50"
                            ItemsSource="{Binding StatusOptions}"
                            SelectedItem="{Binding SelectedStatus}"
                            TextColor="{StaticResource Ink}"
                            TitleColor="{StaticResource Muted}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Margin="0,10,0,0" Spacing="10">
                    <Button
                        Command="{Binding ReadCommand}"
                        HeightRequest="52"
                        Style="{StaticResource ButtonPrimary}"
                        Text="Read" />
                    <Button
                        Command="{Binding DeleteCommand}"
                        HeightRequest="52"
                        Style="{StaticResource ButtonSecondary}"
                        Text="Remove from library"
                        TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
