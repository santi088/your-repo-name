<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="History"
    x:DataType="vm:HistoryViewModel"
    Title="History"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,40" Spacing="16">
            <Label Style="{StaticResource PageTitle}" Text="History" />

            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                HeightRequest="180"
                ItemsSource="{Binding ContinueReading}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <Label Margin="0,0,0,4" Style="{StaticResource SectionCaption}" Text="CONTINUE READING" />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Margin="0,4" Style="{StaticResource Caption}" Text="Open a book and PAGELY will remember where you stopped." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Border Style="{StaticResource CardBorder}" WidthRequest="140">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenBookCommand, Source={x:Reference History}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Border
                                    BackgroundColor="{StaticResource Spine}"
                                    HeightRequest="80"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="22"
                                        HorizontalOptions="Center"
                                        Text="{Binding Initial}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextColor="{StaticResource Ink}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding ProgressLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Style="{StaticResource SectionCaption}" Text="RECENT ACTIVITY" />

            <CollectionView ItemsSource="{Binding Events}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Margin="0,8" Style="{StaticResource Caption}" Text="No reading activity yet." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReadingEvent">
                        <Border Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenEventCommand, Source={x:Reference History}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding BookTitle}"
                                        TextColor="{StaticResource Ink}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding BookAuthor}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding ReadAt, StringFormat='{0:MMM d}'}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
