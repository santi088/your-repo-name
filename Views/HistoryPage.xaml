<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="History"
    x:DataType="vm:HistoryViewModel"
    Title="History"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,40">
            <Label Style="{StaticResource PageTitle}" Text="History" />
            <Label
                Margin="0,2,0,18"
                Style="{StaticResource PageSubtitle}"
                Text="Pick up where you left off" />

            <VerticalStackLayout IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}">

                <Label Style="{StaticResource SectionCaption}" Text="CONTINUE READING" />
                <CollectionView
                    HeightRequest="196"
                    ItemsSource="{Binding ContinueReading}"
                    Margin="0,10,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="12" Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label
                            Margin="0,4"
                            Style="{StaticResource Caption}"
                            Text="Open a book and PAGELY will remember where you stopped." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Book">
                            <Border Padding="12" Style="{StaticResource CardBorder}" WidthRequest="150">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenBookCommand, Source={x:Reference History}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,*,Auto">
                                    <Border
                                        BackgroundColor="{StaticResource Spine}"
                                        HeightRequest="78"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                                Source="{Binding CoverPath}" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="22"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                                Text="{Binding Initial}"
                                                TextColor="{StaticResource Surface}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    <Label
                                        Grid.Row="1"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        LineBreakMode="TailTruncation"
                                        Margin="0,10,0,0"
                                        MaxLines="2"
                                        Text="{Binding Title}"
                                        TextColor="{StaticResource Ink}" />
                                    <VerticalStackLayout Grid.Row="3" Spacing="6">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            Text="{Binding ProgressLabel}"
                                            TextColor="{StaticResource InkSoft}" />
                                        <Border HeightRequest="5" Style="{StaticResource ProgressPill}">
                                            <ProgressBar
                                                BackgroundColor="Transparent"
                                                HeightRequest="5"
                                                Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                                ProgressColor="{StaticResource Primary}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Margin="0,22,0,0" Style="{StaticResource SectionCaption}" Text="RECENT ACTIVITY" />
                <CollectionView ItemsSource="{Binding Events}" Margin="0,10,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label
                            Margin="0,4"
                            Style="{StaticResource Caption}"
                            Text="No reading activity yet." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ReadingEvent">
                            <Border Padding="14" Style="{StaticResource CardBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenEventCommand, Source={x:Reference History}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding BookTitle}"
                                            TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource ChipBorder}"
                                        VerticalOptions="Center">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11"
                                            Text="{Binding ReadAt, StringFormat='{0:MMM d}'}"
                                            TextColor="{StaticResource Muted}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Padding="20,40"
                Spacing="12">
                <Border
                    BackgroundColor="{StaticResource SurfaceAlt}"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    WidthRequest="64">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        HorizontalOptions="Center"
                        Text="P"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="19"
                    HorizontalTextAlignment="Center"
                    Margin="0,2,0,0"
                    Text="Nothing here yet"
                    TextColor="{StaticResource Ink}" />
                <Label
                    HorizontalTextAlignment="Center"
                    MaximumWidthRequest="290"
                    Style="{StaticResource PageSubtitle}"
                    Text="Open a book from your library and your reading activity will show up here." />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
