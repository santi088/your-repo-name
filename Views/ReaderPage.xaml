<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PAGELY.Controls"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:ReaderViewModel"
    Title="{Binding Header}"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header sheet: where you are, how far you are, and the way back. -->
        <Border
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Divider}"
            StrokeShape="RoundRectangle 0,0,20,20"
            StrokeThickness="1">
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="4"
                Padding="12,10,16,14"
                RowDefinitions="Auto,Auto">
                <Button
                    Clicked="OnBackClicked"
                    Style="{StaticResource ButtonIcon}"
                    Text="←" />
                <VerticalStackLayout
                    Grid.Column="1"
                    Padding="10,0,0,0"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Header}"
                        TextColor="{StaticResource Ink}" />
                    <Label Style="{StaticResource CardMeta}" Text="{Binding ProgressLabel}" />
                </VerticalStackLayout>
                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HeightRequest="5"
                    Margin="0,10,0,0"
                    Style="{StaticResource ProgressPill}">
                    <ProgressBar
                        BackgroundColor="Transparent"
                        HeightRequest="5"
                        Progress="{Binding Book.ProgressPercent, Converter={StaticResource PercentToProgress}}"
                        ProgressColor="{StaticResource Primary}" />
                </Border>
            </Grid>
        </Border>

        <!-- Reading surface: text and EPUB through the web view, PDFs page by page. -->
        <Grid Grid.Row="1">
            <WebView
                x:Name="ReaderView"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsPdfMode, Converter={StaticResource InverseBool}}"
                Navigated="OnWebViewNavigated"
                Source="{Binding PageSource}"
                VerticalOptions="Fill" />
            <controls:PdfViewer
                x:Name="PdfReaderView"
                BackgroundColor="{StaticResource PageBackdrop}"
                CurrentPageIndex="{Binding CurrentPdfPage}"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsPdfMode}"
                PagePaths="{Binding PdfPagePaths}"
                PageScrolled="OnPdfPageScrolled"
                RenderWidth="{Binding RenderWidth}"
                SourcePath="{Binding PdfSourcePath}"
                VerticalOptions="Fill" />
        </Grid>

        <!-- Chapter navigation. PDFs scroll natively, so they need no bar. -->
        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource Surface}"
            IsVisible="{Binding IsPdfMode, Converter={StaticResource InverseBool}}"
            Stroke="{StaticResource Divider}"
            StrokeShape="RoundRectangle 20,20,0,0"
            StrokeThickness="1">
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12"
                Padding="20,14,20,20">
                <Button
                    Command="{Binding PreviousCommand}"
                    HeightRequest="52"
                    IsEnabled="{Binding CanGoPrevious}"
                    Style="{StaticResource ButtonSecondary}"
                    Text="← Previous" />
                <Button
                    Grid.Column="1"
                    Command="{Binding NextCommand}"
                    HeightRequest="52"
                    IsEnabled="{Binding CanGoNext}"
                    Style="{StaticResource ButtonPrimary}"
                    Text="Next →" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
