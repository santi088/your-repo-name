<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Library"
    x:DataType="vm:LibraryViewModel"
    Title="Library"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: what the screen is, how much is in it, one primary action. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="20,16,20,12">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Style="{StaticResource PageTitle}" Text="Library" />
                <Label
                    Style="{StaticResource PageSubtitle}"
                    Text="{Binding Books.Count, StringFormat='{0} in your library'}" />
            </VerticalStackLayout>
            <Button
                Grid.Column="1"
                Command="{Binding ImportCommand}"
                Style="{StaticResource ButtonIconPrimary}"
                Text="+" />
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Grid Padding="20,0">
                            <Border Style="{StaticResource CardBorder}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommand, Source={x:Reference Library}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                                    <Border
                                        BackgroundColor="{StaticResource Spine}"
                                        HeightRequest="76"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="52">
                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                                Source="{Binding CoverPath}" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="20"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                                Text="{Binding Initial}"
                                                TextColor="{StaticResource Surface}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label
                                            FontSize="15"
                                            MaxLines="2"
                                            Style="{StaticResource CardTitle}"
                                            Text="{Binding Title}" />
                                        <Label Style="{StaticResource CardMeta}" Text="{Binding Author}" />
                                        <HorizontalStackLayout Margin="0,2,0,0" Spacing="8">
                                            <Border Style="{StaticResource ChipBorder}">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="11"
                                                    Text="{Binding StatusLabel}"
                                                    TextColor="{Binding StatusLabel, Converter={StaticResource StatusColor}}" />
                                            </Border>
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                Text="{Binding ProgressLabel}"
                                                TextColor="{StaticResource InkSoft}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Border
                                            HeightRequest="5"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource ProgressPill}">
                                            <ProgressBar
                                                BackgroundColor="Transparent"
                                                HeightRequest="5"
                                                Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                                ProgressColor="{StaticResource Primary}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                IsVisible="{Binding IsEmpty}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="40,0"
                Spacing="12">
                <Border
                    BackgroundColor="{StaticResource SurfaceAlt}"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    WidthRequest="64">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        HorizontalOptions="Center"
                        Text="P"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="19"
                    HorizontalTextAlignment="Center"
                    Margin="0,2,0,0"
                    Text="Your shelves are empty"
                    TextColor="{StaticResource Ink}" />
                <Label
                    HorizontalTextAlignment="Center"
                    MaximumWidthRequest="290"
                    Style="{StaticResource PageSubtitle}"
                    Text="Import EPUB, PDF or TXT files already on this device. PAGELY works fully offline." />
                <Button
                    Command="{Binding ImportCommand}"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0"
                    Style="{StaticResource ButtonPrimary}"
                    Text="Import a book"
                    WidthRequest="190" />
            </VerticalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
