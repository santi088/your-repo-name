<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Library"
    x:DataType="vm:LibraryViewModel"
    Title="Library"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="20,18,20,10" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        FontFamily="OpenSansSemibold"
                        Text="Library"
                        TextColor="{StaticResource Ink}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    WidthRequest="56"
                    HeightRequest="56"
                    CornerRadius="28"
                    Text="＋"
                    FontSize="24"
                    Padding="0"
                    VerticalOptions="Center">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="20" Offset="0,4" />
                    </Button.Shadow>
                </Button>
            </Grid>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding StatusFilters}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button
                                Clicked="OnStatusClicked"
                                BackgroundColor="{StaticResource Surface}"
                                TextColor="{StaticResource InkSoft}"
                                CornerRadius="20"
                                FontSize="13"
                                FontFamily="OpenSansRegular"
                                HeightRequest="40"
                                Padding="18,0"
                                BorderWidth="0"
                                Text="{Binding .}">
                                <Button.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="20" Offset="0,4" />
                                </Button.Shadow>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None"
                RemainingItemsThreshold="0"
                BackgroundColor="Transparent">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Grid Padding="20,0">
                            <Border
                                BackgroundColor="{StaticResource Card}"
                                Padding="16"
                                Stroke="{StaticResource Divider}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0.5">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="20" Offset="0,4" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommand, Source={x:Reference Library}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="78,*" ColumnSpacing="16">
                                    <Border
                                        BackgroundColor="{StaticResource Spine}"
                                        HeightRequest="108"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        WidthRequest="78">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Opacity="0.08" Radius="20" Offset="0,4" />
                                        </Border.Shadow>
                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                                Source="{Binding CoverPath}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="24"
                                                FontFamily="OpenSansSemibold"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                                Text="{Binding Initial}"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            FontFamily="OpenSansSemibold"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            TextColor="{StaticResource Ink}" />
                                        <Label
                                            FontSize="13"
                                            FontFamily="OpenSansRegular"
                                            Text="{Binding Author}"
                                            TextColor="{StaticResource Muted}" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Border
                                                BackgroundColor="{StaticResource SurfaceAlt}"
                                                Padding="10,4"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 18">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="11"
                                                    FontFamily="OpenSansSemibold"
                                                    Text="{Binding StatusLabel}"
                                                    TextColor="{Binding StatusLabel, Converter={StaticResource StatusColor}}" />
                                            </Border>
                                            <Label FontSize="12" FontFamily="OpenSansRegular" Text="{Binding ProgressLabel}" TextColor="{StaticResource InkSoft}" />
                                        </HorizontalStackLayout>
                                        <ProgressBar
                                            Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                            ProgressColor="{StaticResource Accent}"
                                            HeightRequest="5" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="40,32"
            Spacing="16">
            <Border
                BackgroundColor="{StaticResource SurfaceAlt}"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="0"
                WidthRequest="100"
                HeightRequest="100"
                HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Radius="20" Offset="0,4" />
                </Border.Shadow>
                <Label
                    Text="📚"
                    FontSize="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
            <Label
                FontAttributes="Bold"
                FontSize="24"
                FontFamily="OpenSansSemibold"
                HorizontalTextAlignment="Center"
                Text="{Binding EmptyTitle}"
                TextColor="{StaticResource Ink}" />
            <Label
                FontSize="16"
                FontFamily="OpenSansRegular"
                HorizontalTextAlignment="Center"
                MaximumWidthRequest="300"
                Text="{Binding EmptyMessage}"
                TextColor="{StaticResource Muted}" />
            <Button
                Command="{Binding ImportCommand}"
                Style="{StaticResource ButtonPrimary}"
                WidthRequest="200"
                HeightRequest="56"
                CornerRadius="24"
                Text="Import your first book"
                FontAttributes="Bold"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center"
                Margin="0,10,0,0">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Radius="20" Offset="0,4" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>

