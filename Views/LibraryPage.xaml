<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Library"
    x:DataType="vm:LibraryViewModel"
    Title="Library"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <Grid ColumnDefinitions="*,Auto" Padding="20,18,20,12">
            <Label
                Grid.Column="0"
                Style="{StaticResource PageTitle}"
                Text="Library"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Command="{Binding ImportCommand}"
                Style="{StaticResource ButtonPrimary}"
                Text="+"
                FontSize="20"
                Padding="0"
                WidthRequest="44"
                HeightRequest="44"
                MinimumHeightRequest="44"
                CornerRadius="12"
                VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Grid Padding="20,0">
                            <Border Style="{StaticResource CardBorder}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommand, Source={x:Reference Library}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                                    <Border
                                        BackgroundColor="{StaticResource Spine}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        HeightRequest="80"
                                        WidthRequest="56">
                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                                Source="{Binding CoverPath}" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="20"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                                Text="{Binding Initial}"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            TextColor="{StaticResource Ink}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Author}" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Border Style="{StaticResource ChipBorder}">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="11"
                                                    Text="{Binding StatusLabel}"
                                                    TextColor="{Binding StatusLabel, Converter={StaticResource StatusColor}}" />
                                            </Border>
                                            <Label
                                                Style="{StaticResource Caption}"
                                                Text="{Binding ProgressLabel}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <ProgressBar
                                            BackgroundColor="{StaticResource SurfaceAlt}"
                                            HeightRequest="3"
                                            Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                            ProgressColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                IsVisible="{Binding IsEmpty}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="40,0"
                Spacing="10">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="Your shelves are empty"
                    TextColor="{StaticResource Ink}" />
                <Label
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    MaximumWidthRequest="280"
                    Text="Import EPUB or TXT books already on this device. PAGELY works fully offline."
                    TextColor="{StaticResource Muted}" />
                <Button
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0"
                    Text="Import a book"
                    WidthRequest="180" />
            </VerticalStackLayout>

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
